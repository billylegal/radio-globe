{"title": "Andos - vetebesimi", "key": "a512aa6704e0", "lang": "pt", "lines": [{"t": 41.3, "l": "Mósofondós, na minha larga si,"}, {"t": 51.3, "l": "Curta-gente a arroa e-a-de,"}, {"t": 55.3, "l": "Mósoco e Tossáher, elando-ar,"}, {"t": 60.3, "l": "Sais do herdo e-a-jipendo-ar,"}, {"t": 65.3, "l": "Cuiê e humo tipo a vartó"}, {"t": 70.3, "l": "De nessa mão, desculou"}, {"t": 74.3, "l": "Miran sin daie me acedou"}, {"t": 79.3, "l": "Loubantam de não ver de cor"}, {"t": 84.3, "l": "Oh, o ato besoi"}, {"t": 188.9, "l": "Oh, o ato besou, expresso em jincão"}], "model": "whisper-small", "ts": 1791929578, "ai": true}