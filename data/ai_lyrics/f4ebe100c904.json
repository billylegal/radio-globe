{"title": "Mishary Alafasi - Al-Muddaththir", "key": "f4ebe100c904", "lang": "ar", "lines": [{"t": 21.8, "l": "على الكافرين غير يسير"}, {"t": 28.7, "l": "ذرني ومن خلقت وحيدا"}, {"t": 32.7, "l": "وجعلت له مالا ممدودا"}, {"t": 37.3, "l": "وبنين شهودا"}, {"t": 39.9, "l": "ومهدت له تمهيدا"}, {"t": 43.3, "l": "ثم يطمع أن أزيد"}, {"t": 48.5, "l": "كلا إنه كان لآياتنا عنيدا"}, {"t": 55.1, "l": "سأرهقه صعودا"}, {"t": 58.1, "l": "إنه فكر وقدر"}, {"t": 61.5, "l": "فقتل كيف قدر"}, {"t": 63.9, "l": "ثم قتل كيف قدر"}, {"t": 67.5, "l": "ثم نظر"}, {"t": 69.8, "l": "ثم عبس وبسر"}, {"t": 73.0, "l": "ثم أدبر واستكبر"}, {"t": 76.5, "l": "فقال إن هذا إلا سحر يؤثر"}, {"t": 82.9, "l": "إن هذا إلا قول البشر"}, {"t": 87.8, "l": "سأصليه سقر"}, {"t": 90.1, "l": "وما أدراك ما سقر"}, {"t": 94.3, "l": "لا تبقي ولا تذر"}, {"t": 97.2, "l": "لواحة للبشر"}, {"t": 99.9, "l": "عليها تسعة عشر"}, {"t": 102.7, "l": "وما جعلنا أصحاب النار إلا ملائكة وما جعلنا عدتهم إلا فتنة للذين كفروا ليستيقن الذين أوتوا الكتاب"}, {"t": 122.7, "l": "ويزداد الذين آمنوا إيمانا ولا يرتاب الذين أوتوا الكتاب والمؤمنون"}, {"t": 134.6, "l": "وليقول الذين في قلوبهم مرضوا والكافرون"}, {"t": 141.9, "l": "ماذا أراد الله بهذا مثلا"}, {"t": 147.5, "l": "كذلك يضل الله من يشاء ويهدي من يشاء"}, {"t": 159.1, "l": "وما يعلم جنود ربك إلا هو"}, {"t": 163.9, "l": "وما هي إلا ذكرى للبشر"}, {"t": 167.8, "l": "كلا والقمر والليل إذ أدبر"}, {"t": 172.6, "l": "والصبح إذا أسفر"}, {"t": 176.5, "l": "إنها لإحدى الكبر نذيرا للبشر"}, {"t": 182.4, "l": "لمن شاء منكم أن يتقدم أو يتأخر"}, {"t": 191.2, "l": "كل نفس بما كسبت رهينة إلا أصحاب اليمين"}, {"t": 202.0, "l": "في جنات يتساءلون"}, {"t": 209.7, "l": "عن المجرمين"}, {"t": 214.0, "l": "ما سلككم في سقر"}, {"t": 216.8, "l": "قالوا لم نكن من المصلين"}, {"t": 222.1, "l": "ولم نكن طعم المسكين"}, {"t": 227.1, "l": "وكنا نخوض مع الخائضين"}, {"t": 234.2, "l": "وكنا نكذب بيوم الدين"}, {"t": 240.6, "l": "حتى أتانا اليقين"}, {"t": 246.5, "l": "فما تنفعهم شفاعة الشافعين"}, {"t": 253.2, "l": "فما لهم عن التذكرة معينة"}], "model": "whisper-large-v3-turbo", "ts": 1792500562, "ai": true}