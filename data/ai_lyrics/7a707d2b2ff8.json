{"title": "BOA FT JOSIPA LISAC - PRAVDA", "key": "7a707d2b2ff8", "lang": "hr", "lines": [{"t": 31.9, "l": "No je kad bok sam sudi, prekasno zapunuju dili."}, {"t": 41.9, "l": "Da vjerujem sada, kažu pravda će daoči."}, {"t": 53.9, "l": "Kažu pravda će daoči."}, {"t": 61.9, "l": "Ali potaje sve isto zloje"}, {"t": 66.9, "l": "Dobro, dobro je zločisto"}, {"t": 75.2, "l": "Samo ravna crta postojanja"}, {"t": 80.2, "l": "Bjezna igra održav"}, {"t": 86.9, "l": "Da li umornismo od svih nada? Od svojih ili tuži jada?"}, {"t": 96.9, "l": "Da li mirim se sa očajanje? Možda mrtla se ali i vpate."}, {"t": 107.9, "l": "Da verujem sada"}, {"t": 111.9, "l": "Kažu, pravda če dalči"}, {"t": 120.9, "l": "Kažu, pravda če dalči"}, {"t": 129.9, "l": "Kažu, pravda če dalči"}, {"t": 137.9, "l": "Kažu pravda čedouci"}, {"t": 173.9, "l": "Kajšu pravda če da oči?"}, {"t": 203.9, "l": "Pravda čudovži!"}, {"t": 233.9, "l": "Mislim,"}, {"t": 249.9, "l": "Ca moj jednom seđi ubi,"}, {"t": 253.9, "l": "Sve je ostalo varetna,"}, {"t": 257.9, "l": "Često udes nam grubi,"}, {"t": 261.9, "l": "Kale zpijati se"}, {"t": 265.7, "l": "Zato misli"}], "model": "whisper-small", "ts": 1791931401, "ai": true}