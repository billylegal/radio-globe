{"title": "Mahmoud Khalil Al-Hussary - Al-Ma'arij", "key": "913f76611812", "lang": "ar", "lines": [{"t": 12.7, "l": "بعذاب واقع"}, {"t": 17.0, "l": "للكفرين ليس له دافع"}, {"t": 24.5, "l": "من الله ذي المعارج"}, {"t": 29.7, "l": "تعرج الملائكة والروح إليه في يوم كان مقداره خمسين ألف سنة"}, {"t": 49.6, "l": "فاصبر صبرا جميلا"}, {"t": 57.5, "l": "إنهم يرونه بعيدا"}, {"t": 65.3, "l": "ونراه قريبا"}, {"t": 70.2, "l": "يوم تكون السماء كالمهن"}, {"t": 78.9, "l": "وتكون الجبال كالعهن"}, {"t": 84.5, "l": "ولا يسأل حميم حميما"}, {"t": 91.3, "l": "يبصرونهم"}, {"t": 96.5, "l": "يود المجرم لو يفتدي من عذاب يومئذ ببنيه"}, {"t": 110.3, "l": "وصاحبته وأخيه"}, {"t": 117.4, "l": "وفصيلته التي تؤويه"}, {"t": 125.0, "l": "ومن في الأرض جميعا ثم ينجيه"}, {"t": 135.6, "l": "كلا إنها لضا"}, {"t": 142.6, "l": "نزاعة للشوى"}, {"t": 148.0, "l": "تدعو من ادبر وتولى"}, {"t": 154.0, "l": "وجمع فأوعى"}, {"t": 158.0, "l": "إن الإنسان خلق هلوعى"}, {"t": 165.2, "l": "إذا مسه الشر جزوعا"}, {"t": 171.6, "l": "وإذا مسه الخير منوعا"}, {"t": 178.5, "l": "إلا المصلين"}, {"t": 183.6, "l": "الذين هم على صلاتهم دائمون"}, {"t": 194.4, "l": "والذين في أموالهم حق معلوم"}, {"t": 206.5, "l": "للسائل والمحروم"}, {"t": 215.1, "l": "والذين يصدقون بيوم الدين"}, {"t": 225.7, "l": "والذين هم من عذاب ربهم مشفقون"}, {"t": 236.9, "l": "إن عذاب ربهم غير مامون"}], "model": "whisper-large-v3-turbo", "ts": 1792028108, "ai": true}