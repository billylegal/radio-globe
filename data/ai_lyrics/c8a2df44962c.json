{"title": "ДОНИ И НЕТИ - ИМА ВРЕМЕ", "key": "c8a2df44962c", "lang": "bg", "lines": [{"t": 20.3, "l": "За геройи и предатели, за любов и за война."}, {"t": 31.6, "l": "Има време, бях на хиляди места."}, {"t": 39.6, "l": "Гледах от ини залези, виждах чужда свобода."}, {"t": 45.8, "l": "Има много време, нека седнем за това"}, {"t": 54.1, "l": "Да погледаме със теб земята, да послушаме дълждата"}, {"t": 63.9, "l": "Има много време, няма време за това"}, {"t": 70.7, "l": "да седим свободата скрита"}, {"t": 75.9, "l": "вътре в нашата тишина."}, {"t": 81.4, "l": "Има време"}, {"t": 83.7, "l": "да забавим скоро отгад,"}, {"t": 88.3, "l": "нека бърза само вятъра"}, {"t": 92.0, "l": "да препуска пред света."}, {"t": 97.7, "l": "Има време"}, {"t": 100.3, "l": "За далечните места"}, {"t": 103.5, "l": "Ще ги гледаме, но някога"}, {"t": 108.8, "l": "Тук е нашата свобода"}, {"t": 112.1, "l": "Има много време"}, {"t": 117.7, "l": "Нека седнем за това"}, {"t": 120.5, "l": "Да погледаме с теб земята"}, {"t": 125.5, "l": "Да послушаме дождя"}, {"t": 129.5, "l": "Има много време, няма време за това,"}, {"t": 137.5, "l": "да усетим слобода нескрита,"}, {"t": 142.5, "l": "отрев нашата тисина."}, {"t": 189.5, "l": "Да погледаме със те певята, да послушаме тъждам."}, {"t": 199.8, "l": "Има много време, няма време за това."}, {"t": 207.3, "l": "Да усетим свобода, да скрита, вътре в нашата тишина."}, {"t": 213.4, "l": "Да усетим свободата скрита"}, {"t": 219.0, "l": "Вътре в нашата тишина"}, {"t": 222.0, "l": "Има време"}], "model": "whisper-large-v3-turbo", "ts": 1792237205, "ai": true}