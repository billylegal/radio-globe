{"title": "ZUZANA MICHNOVA & MARSYAS - S LUISEM", "key": "095b889e5f2a", "lang": "cs", "lines": [{"t": 18.7, "l": "Míchám koktejl právě z fantazie, světlá stínu, Luizi, rozumíš?"}, {"t": 31.4, "l": "Oči síní, temné vlíla"}, {"t": 48.1, "l": "Tak se zabírá slunce sává"}, {"t": 56.3, "l": "Krátký letní výhled"}, {"t": 63.7, "l": "S fantazí"}, {"t": 65.1, "l": "A jednou z nálad"}, {"t": 67.6, "l": "Já tě přivolám"}, {"t": 70.3, "l": "Luizi"}, {"t": 72.8, "l": "Má sílu anděl zkázy"}, {"t": 80.2, "l": "Nohy mi stěžkly záhy"}, {"t": 85.8, "l": "a zvíčky na mě hází opojení."}, {"t": 93.4, "l": "Zem se zdávě líně použí,"}, {"t": 99.2, "l": "procesy hléčné dráhy,"}, {"t": 102.9, "l": "jak zvláštně každý použí ospojení."}, {"t": 106.8, "l": "K nebizí rám"}, {"t": 116.2, "l": "bosá v trávě"}, {"t": 118.3, "l": "Tvoje poselství"}, {"t": 124.1, "l": "to mě chrání"}, {"t": 126.6, "l": "Ráda"}, {"t": 131.5, "l": "proč tu závěť"}, {"t": 134.1, "l": "fantazie"}, {"t": 135.4, "l": "Snů a přálení na mřem zůstanou"}, {"t": 140.7, "l": "Oh, is it"}, {"t": 165.4, "l": "Má sílu, anděl zkázy,"}, {"t": 185.2, "l": "nohy mi z těžky záhy,"}, {"t": 188.7, "l": "a z výšky na mně hází opojení."}, {"t": 195.4, "l": "Zem se z dálky líně plouží, procesy vléčné dráhy,"}, {"t": 206.4, "l": "kde zvláště každý touží o spojení."}, {"t": 213.6, "l": "Má z dílu anděl stázy, nohy mu seškly záhy"}, {"t": 222.5, "l": "A z výšky na mě hází opojení"}, {"t": 227.6, "l": "Zem se stáky výmět použít"}, {"t": 233.9, "l": "Procesy mléčné krávy"}, {"t": 239.3, "l": "Rádio Být"}, {"t": 242.9, "l": "Být být naživo"}, {"t": 252.5, "l": "www.hradeckralove.org"}], "model": "whisper-large-v3-turbo", "ts": 1792300824, "ai": true}