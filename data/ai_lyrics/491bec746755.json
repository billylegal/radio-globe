{"title": "Rhum and coca cola… - ARIELLE DOMBASLE", "key": "491bec746755", "lang": "en", "lines": [{"t": 34.6, "l": "They got the young girls all going there"}, {"t": 37.3, "l": "Young girls say they treat them nice"}, {"t": 40.0, "l": "Make Trinidad like paradise"}, {"t": 42.4, "l": "Drink rum and Coca-Cola"}, {"t": 45.2, "l": "Go down, pour and cool wine up"}, {"t": 48.2, "l": "Both mother and the girl"}, {"t": 50.7, "l": "Working for the Yankee dollar"}, {"t": 53.5, "l": "From Chica-Chica-Ree to Mono-Sai"}, {"t": 61.4, "l": "Many girls all dance as mine"}, {"t": 64.3, "l": "Albus, Sonia, celebrate his sleep"}, {"t": 66.8, "l": "Make every day like New Year's Eve"}, {"t": 69.3, "l": "Drinking rum and Coca-Cola"}, {"t": 72.3, "l": "Go down Point Cubana"}, {"t": 75.3, "l": "Both mother and daughter"}, {"t": 77.3, "l": "Looking for the Yankee dolla"}, {"t": 82.3, "l": "Oh, fit it, man, fit it"}, {"t": 85.3, "l": "In old Trinidad, I also fear"}, {"t": 88.3, "l": "The situation is mighty queer"}, {"t": 90.3, "l": "Like the Yankee girl, the native swoon"}, {"t": 93.3, "l": "When she heard her bingo crowing rum and coca-cola"}, {"t": 99.0, "l": "Go down, go down, go down, go down"}, {"t": 101.6, "l": "Both mother and daughter"}, {"t": 104.0, "l": "Working for the Yankee dollar"}, {"t": 107.0, "l": "Out on Manzanilla Beach"}, {"t": 115.0, "l": "Chiaro man, sweet native beach"}, {"t": 117.7, "l": "All night long make tropic love"}, {"t": 120.3, "l": "Next day sit in hot sun and cool love"}, {"t": 123.0, "l": "Drinking rum and coca-cola"}, {"t": 125.9, "l": "Go dump on kumana"}, {"t": 128.6, "l": "Both mother and daughter"}, {"t": 131.3, "l": "Working for the Yankee Dollar"}, {"t": 141.9, "l": "Rum and coca-cola"}, {"t": 147.1, "l": "Rum and coca-cola"}], "model": "whisper-large-v3-turbo", "ts": 1792131174, "ai": true}