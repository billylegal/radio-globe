{"title": "سليمان العيد - وإنه لتنزيل رب العالمين", "key": "b63803643161", "lang": "ar", "lines": [{"t": 17.7, "l": "إنه لفي زبر الأولين"}, {"t": 22.1, "l": "أولم يكن لهم آية أن يعلمه علماء بني إسرائيل"}, {"t": 32.8, "l": "ولو نزلناه على بعض الأعجمين"}, {"t": 39.0, "l": "فقرأه عليهم ما كانوا به مؤمنين"}, {"t": 46.2, "l": "كذلك سلكناه في قلوب المجرمين"}, {"t": 52.7, "l": "لا يؤمنون به حتى يروا العذاب الأليم"}, {"t": 59.9, "l": "فيأتيهم بغتة وهم لا يشعرون"}, {"t": 67.0, "l": "فيقولوا هل نحن منظرون"}, {"t": 72.3, "l": "أفبعذابنا يستعجلون"}, {"t": 77.6, "l": "أفرأيت إن متعناهم سنين"}, {"t": 83.6, "l": "ثم جاءهم ما كانوا يوعدون"}, {"t": 90.1, "l": "ما أغنى عنهم ما كانوا يمتعون"}, {"t": 97.2, "l": "وما أهلكنا من قرية إلا لها منذرون"}, {"t": 106.3, "l": "ذكرا وما كنا ظالمين"}, {"t": 112.0, "l": "وما تنزلت به الشياطين"}, {"t": 116.8, "l": "وما ينبغي لهم وما يستطيعون"}, {"t": 123.5, "l": "إنهم عن السمع لمعزولون"}, {"t": 129.2, "l": "فلا تدعوا مع الله إلها آخر فتكون من المعذبين"}, {"t": 138.3, "l": "وأنذر عشيرتك الأطربين"}, {"t": 143.8, "l": "واخفض جناحك لمن اتبعك من المؤمنين"}, {"t": 150.7, "l": "فإن عصوك فقل إني بريء مما تعملون"}, {"t": 159.4, "l": "هدى للناس"}, {"t": 165.1, "l": "أعوذ بالله من الشيطان الرجيم"}, {"t": 169.4, "l": "لقد كان لكم في رسول الله أسوة حسنة"}], "model": "whisper-large-v3-turbo", "ts": 1791963896, "ai": true}