{"title": "Shyshlevskiy - Байдуже (Wed Hoill Edit)", "key": "0c40fee556dc", "lang": "ru", "lines": [{"t": 8.1, "l": "Байдуже"}, {"t": 38.1, "l": "Ты молчишь, и я молчу"}, {"t": 46.1, "l": "Я больше болю не чую"}, {"t": 50.1, "l": "Байдуже, ты молчишь"}, {"t": 56.1, "l": "Ты молчишь, и я молчу"}, {"t": 62.1, "l": "Байдуже"}, {"t": 64.1, "l": "Ничный дак сит, порожний день"}, {"t": 68.9, "l": "Мы загубились у себя сами"}, {"t": 72.8, "l": "Ты дивишься окреть меня снова"}, {"t": 77.1, "l": "Это не война, это не любовь"}, {"t": 81.8, "l": "Твои слова я бил в скло"}, {"t": 84.1, "l": "Забудь все, что у нас было"}, {"t": 88.1, "l": "Забудь мой дом, забудь мой звук"}, {"t": 92.4, "l": "Я выпускаю твою руку с рук"}, {"t": 97.4, "l": "Боих уже, в первой неже, а не дужи"}, {"t": 103.4, "l": "Твихолочки, в мою речь"}, {"t": 106.4, "l": "Ты мовчишь, и я мовчу"}, {"t": 110.4, "l": "Но перед линией, я лечу"}, {"t": 114.4, "l": "И дужи, в неже, а не дужи"}, {"t": 118.4, "l": "Твихолочки, в мою речь"}, {"t": 122.4, "l": "И мовчишь, и я мовчу"}, {"t": 125.9, "l": "До тебя пише, ноль"}, {"t": 130.1, "l": "На годиннику не разложи"}, {"t": 132.1, "l": "Мы начать тенью, мы начать чужие"}, {"t": 134.1, "l": "Навіше ці роли, навіше цей грим"}, {"t": 136.1, "l": "Наш идеальний свиста пустим"}, {"t": 138.5, "l": "Кожен бейже, це просто гра"}, {"t": 140.6, "l": "Нам зупинитися пора"}, {"t": 142.7, "l": "Ти кажеш тій, я кажу йди"}, {"t": 144.6, "l": "Ми розмиваємо свої сліди"}, {"t": 147.4, "l": "Ай, боже"}, {"t": 151.7, "l": "Тоби и меню"}, {"t": 155.3, "l": "Мы просто"}, {"t": 157.2, "l": "Отворяем в огни"}, {"t": 161.1, "l": "Три мать"}, {"t": 164.8, "l": "Три мать"}], "model": "whisper-large-v3-turbo", "ts": 1792309757, "ai": true}