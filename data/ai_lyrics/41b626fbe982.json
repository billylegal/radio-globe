{"title": "Matadi - MBARKE NDIAYE Feat. King Baba", "key": "41b626fbe982", "lang": "fr", "lines": [{"t": 37.8, "l": "Malamata dame d'Akarsen, wawakadlen,"}, {"t": 39.8, "l": "Comédie Lenny Jogaisen,"}, {"t": 41.8, "l": "Kudu Chinwar Dangaisen,"}, {"t": 43.8, "l": "Walumaisen, Nopuyugudu Njombarsen, eh!"}, {"t": 45.8, "l": "Boro geringe de pat, daka jingama apart,"}, {"t": 47.8, "l": "Tengilje katis sabbat,"}, {"t": 49.8, "l": "Bosa geringe mba pat, bai falubay du kat,"}, {"t": 51.8, "l": "N'gengengeni marcatu tata,"}, {"t": 53.8, "l": "Sonon deko to poto,"}, {"t": 55.8, "l": "Bukholam tibon deko sen aifoto,"}, {"t": 57.8, "l": "Ya monotopon do,"}, {"t": 59.8, "l": "Maiwak nga nyodi aishoko shoko."}, {"t": 61.8, "l": "Malamu Mumbai, dimakchi ibranajo,"}, {"t": 63.8, "l": "Wali kumumeti,"}], "model": "whisper-large-v3-turbo", "ts": 1792351717, "ai": true}